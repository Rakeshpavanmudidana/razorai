                    ┌─────────────────────────────────┐
                    │       Spring Boot Backend       │
                    │                                 │
                    │  Controllers                    │
                    │  Services                       │
                    │  AI Service                     │
                    │  AI Tool Service                │
                    │  Cart / Order Services          │
                    │  Payment Service                │
                    └──────────────┬──────────────────┘
                                   │
                    ┌──────────────┴──────────────┐
                    │                             │
                    ▼                             ▼
          ┌──────────────────┐          ┌──────────────────┐
          │  Gemini AI       │          │ Neon PostgreSQL  │
          │                  │          │                  │
          │ Intent           │          │ Products         │
          │ Reasoning        │          │ Categories       │
          │ Recommendations  │          │ Cart             │
          │ Agent Actions    │          │ Orders           │
